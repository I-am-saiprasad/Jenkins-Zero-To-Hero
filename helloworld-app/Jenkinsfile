pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-11-openjdk'
        PATH = "$JAVA_HOME/bin:$PATH"
    }

    stages {
        stage('Checkout') {
            steps {
                // Checkout the code from GitHub
                git 'https://github.com/I-am-saiprasad/Jenkins-Zero-To-Hero.git'
            }
        }

        stage('Build') {
            steps {
                // Compile the Java code
                sh 'javac HelloWorld.java'
            }
        }

        stage('Test') {
            steps {
                // Run the Java program
                sh 'java HelloWorld'
            }
        }

        stage('Archive') {
            steps {
                // Archive the build (if required)
                archiveArtifacts artifacts: '**/*.class', allowEmptyArchive: true
            }
        }

        stage('Deploy') {
            steps {
                // Optionally deploy your app, if needed
                echo 'Deploying Hello World App'
            }
        }
    }

    post {
        always {
            // Clean up actions, if any
            echo 'Pipeline completed!'
        }
    }
}

