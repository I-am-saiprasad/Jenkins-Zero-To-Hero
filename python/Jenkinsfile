pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git 'https://github.com/I-am-saiprasad/Jenkins-Zero-To-Hero.git'
            }
        }

        stage('Set up Virtual Environment') {
            steps {
                sh 'python3 -m venv venv'  // Create a virtual environment
                sh 'source venv/bin/activate'  // Activate the virtual environment
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'pip install -r requirements.txt'  // Install dependencies in the virtual environment
            }
        }

        stage('Run Tests') {
            steps {
                sh 'pytest test_app.py'  // Run your tests
            }
        }
    }
}
