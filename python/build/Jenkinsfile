pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/your-repo/your-flask-app.git'
            }
        }

        stage('Set Up Virtual Environment') {
            steps {
                sh 'python3 -m venv myappenv'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    . myappenv/bin/activate
                    pip install flask
                '''
            }
        }

        stage('Run Application') {
            steps {
                sh '''
                    . myappenv/bin/activate
                    python3 app.py &
                '''
            }
        }
    }
}
