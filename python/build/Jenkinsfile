pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/your-repo/your-flask-app.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'python3 -m venv myappenv'
                sh 'source myappenv/bin/activate && pip install -r requirements.txt'
            }
        }

        stage('Run Application') {
            steps {
                sh 'source myappenv/bin/activate && python3 app.py &'
            }
        }
    }
}
